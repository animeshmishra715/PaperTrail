# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Must match AI_SERVICE_KEY in backend/.env (any random string)
AI_SERVICE_KEY=change-me-to-a-random-string

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=220
CHUNK_OVERLAP=40
TOP_K=8
MIN_SCORE=0.15
