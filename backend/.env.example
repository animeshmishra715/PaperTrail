PORT=5000
# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/papertrail?retryWrites=true&w=majority
# Any long random string
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://127.0.0.1:8000
# Must match AI_SERVICE_KEY in ai-service/.env
AI_SERVICE_KEY=change-me-to-a-random-string

CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
